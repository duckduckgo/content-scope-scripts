{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "OnConfigChangedParams",
  "description": "Pushed to every YouTube tab when the user changes a SponsorBlock setting.",
  "required": ["enabled", "skipMode"],
  "additionalProperties": false,
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "skipMode": {
      "type": "string",
      "enum": ["manual", "auto"]
    }
  }
}
