{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ApplyParams",
  "description": "Native sends translations to write back.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "updates"
  ],
  "properties": {
    "updates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "number"
          },
          "text": {
            "type": "string"
          }
        }
      }
    }
  }
}
