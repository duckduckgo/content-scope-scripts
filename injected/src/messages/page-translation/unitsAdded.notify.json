{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UnitsAdded",
  "description": "Units for content that appeared after extract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "units"
  ],
  "properties": {
    "units": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Unit"
      }
    }
  },
  "definitions": {
    "Unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "html",
        "vp"
      ],
      "properties": {
        "id": {
          "type": "number",
          "description": "Unit id, unique for the page's lifetime."
        },
        "text": {
          "type": "string",
          "description": "Plain text, or an HTML fragment when html is true."
        },
        "html": {
          "type": "boolean",
          "description": "Whether text is an HTML fragment (translate with isHtml)."
        },
        "vp": {
          "type": "number",
          "enum": [
            0,
            1
          ],
          "description": "1 when the unit intersects the viewport."
        }
      },
      "title": "Unit"
    }
  }
}
