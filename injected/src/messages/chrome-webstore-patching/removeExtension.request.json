{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RemoveExtensionParams",
  "description": "macOS: ask native to remove a curated extension.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "extensionId"
  ],
  "properties": {
    "extensionId": {
      "type": "string",
      "pattern": "^[a-p]{32}$",
      "description": "Chrome Web Store extension ID."
    }
  }
}
