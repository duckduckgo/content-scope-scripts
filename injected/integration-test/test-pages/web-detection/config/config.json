{
    "readme": "Config demonstrating webDetection feature with various detector configurations",
    "version": 1,
    "unprotectedTemporary": [],
    "features": {
        "breakageReporting": {
            "state": "enabled",
            "hash": "test",
            "exceptions": []
        },
        "webDetection": {
            "state": "enabled",
            "hash": "test",
            "exceptions": [],
            "settings": {
                "detectors": {
                    "adwall": {
                        "generic_text": {
                            "actions": [
                                {
                                    "when": {
                                        "text": {
                                            "pattern": [
                                                "ad ?block(er)? detected",
                                                "disable your ad ?blocker"
                                            ]
                                        }
                                    },
                                    "breakageReportData": {},
                                    "define": {
                                        "done": true
                                    }
                                }
                            ]
                        },
                        "paywall_element": {
                            "actions": [
                                {
                                    "when": {
                                        "element": {
                                            "selector": ".paywall-overlay",
                                            "visibility": "visible"
                                        }
                                    },
                                    "breakageReportData": {},
                                    "define": {
                                        "done": true
                                    }
                                }
                            ]
                        }
                    },
                    "video": {
                        "unavailable": {
                            "actions": [
                                {
                                    "when": {
                                        "text": {
                                            "pattern": "video (is )?unavailable",
                                            "selector": ".video-error, .player-error"
                                        }
                                    },
                                    "breakageReportData": {},
                                    "define": {
                                        "done": true
                                    }
                                }
                            ]
                        }
                    },
                    "combined": {
                        "text_and_element": {
                            "actions": [
                                {
                                    "when": {
                                        "text": {
                                            "pattern": "subscribe to continue"
                                        },
                                        "element": {
                                            "selector": ".subscribe-modal"
                                        }
                                    },
                                    "breakageReportData": {},
                                    "define": {
                                        "done": true
                                    }
                                }
                            ]
                        }
                    },
                    "custom": {
                        "trigger_disabled": {
                            "actions": [
                                {
                                    "when": {
                                        "text": {
                                            "pattern": "trigger disabled test"
                                        }
                                    },
                                    "breakageReportData": {},
                                    "define": {
                                        "done": true
                                    }
                                }
                            ],
                            "triggers": {
                                "breakageReport": {
                                    "state": "disabled"
                                }
                            }
                        },
                        "action_disabled": {
                            "actions": [
                                {
                                    "when": {
                                        "text": {
                                            "pattern": "action disabled test"
                                        }
                                    },
                                    "define": {
                                        "done": true
                                    }
                                }
                            ]
                        },
                        "detector_disabled": {
                            "state": "disabled",
                            "actions": [
                                {
                                    "when": {
                                        "text": {
                                            "pattern": "detector disabled test"
                                        }
                                    },
                                    "breakageReportData": {},
                                    "define": {
                                        "done": true
                                    }
                                }
                            ]
                        },
                        "domain_restricted": {
                            "actions": [
                                {
                                    "when": {
                                        "text": {
                                            "pattern": "domain restricted test"
                                        }
                                    },
                                    "breakageReportData": {},
                                    "define": {
                                        "done": true
                                    }
                                }
                            ],
                            "triggers": {
                                "breakageReport": {
                                    "runConditions": {
                                        "domain": "example.com"
                                    }
                                }
                            }
                        }
                    },
                    "autorun": {
                        "basic_auto": {
                            "actions": [
                                {
                                    "when": {
                                        "text": {
                                            "pattern": "auto run test"
                                        }
                                    },
                                    "breakageReportData": {},
                                    "define": {
                                        "done": true
                                    }
                                }
                            ],
                            "triggers": {
                                "auto": {
                                    "state": "enabled",
                                    "when": {
                                        "intervalMs": [
                                            100,
                                            300
                                        ]
                                    }
                                }
                            }
                        },
                        "delayed_content": {
                            "actions": [
                                {
                                    "when": {
                                        "text": {
                                            "pattern": "first success test"
                                        }
                                    },
                                    "breakageReportData": {},
                                    "define": {
                                        "done": true
                                    }
                                }
                            ],
                            "triggers": {
                                "auto": {
                                    "state": "enabled",
                                    "when": {
                                        "intervalMs": [
                                            100,
                                            200,
                                            300
                                        ]
                                    }
                                }
                            }
                        },
                        "auto_disabled": {
                            "actions": [
                                {
                                    "when": {
                                        "text": {
                                            "pattern": "auto disabled test"
                                        }
                                    },
                                    "breakageReportData": {},
                                    "define": {
                                        "done": true
                                    }
                                }
                            ],
                            "triggers": {
                                "auto": {
                                    "state": "disabled",
                                    "when": {
                                        "intervalMs": [
                                            100
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
