{
    "readme": "Config with webEvents feature disabled - no webEvent messages should be sent",
    "version": 1,
    "unprotectedTemporary": [],
    "features": {
        "webDetection": {
            "state": "enabled",
            "hash": "test",
            "exceptions": [],
            "settings": {
                "detectors": {
                    "adwall": {
                        "fire_event_text": {
                            "actions": [
                                {
                                    "when": {
                                        "text": {
                                            "pattern": "ad ?block(er)? detected"
                                        }
                                    },
                                    "fireEvent": {
                                        "type": "adwall"
                                    },
                                    "breakageReportData": {},
                                    "define": {
                                        "done": true
                                    }
                                }
                            ],
                            "triggers": {
                                "auto": {
                                    "state": "enabled",
                                    "when": {
                                        "intervalMs": [
                                            50
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "webEvents": {
            "state": "disabled",
            "hash": "test",
            "exceptions": []
        }
    }
}
