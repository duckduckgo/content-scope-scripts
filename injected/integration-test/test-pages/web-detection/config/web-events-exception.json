{
    "readme": "Config with webEvents disabled on localhost via additionalCheck + conditionalChanges",
    "version": 1,
    "unprotectedTemporary": [],
    "features": {
        "webDetection": {
            "state": "enabled",
            "hash": "test",
            "exceptions": [],
            "settings": {
                "detectors": {
                    "adwall": {
                        "fire_event_text": {
                            "actions": [
                                {
                                    "when": {
                                        "text": {
                                            "pattern": "ad ?block(er)? detected"
                                        }
                                    },
                                    "fireEvent": {
                                        "type": "adwall"
                                    },
                                    "breakageReportData": {},
                                    "define": {
                                        "done": true
                                    }
                                }
                            ],
                            "triggers": {
                                "auto": {
                                    "state": "enabled",
                                    "when": {
                                        "intervalMs": [
                                            50
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "webEvents": {
            "state": "enabled",
            "hash": "test",
            "exceptions": [],
            "settings": {
                "additionalCheck": "enabled",
                "conditionalChanges": [
                    {
                        "condition": {
                            "domain": "localhost"
                        },
                        "patchSettings": [
                            {
                                "op": "replace",
                                "path": "/additionalCheck",
                                "value": "disabled"
                            }
                        ]
                    }
                ]
            }
        }
    }
}
