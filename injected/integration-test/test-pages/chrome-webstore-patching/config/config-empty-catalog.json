{
    "readme": "chromeWebstorePatching fixture with an enabled curatedExtensions carrying an empty, malformed catalog: nothing is curated, so every extension must read as unsupported.",
    "version": 1,
    "features": {
        "chromeWebstorePatching": {
            "state": "internal",
            "exceptions": [],
            "settings": {
                "patchWebstore": {
                    "state": "disabled"
                },
                "installButtonSelectors": [
                    {
                        "type": "css",
                        "value": "button[jsname=\"wQO0od\"]"
                    },
                    {
                        "type": "css",
                        "value": "button[jsname=\"ajZLRd\"]"
                    },
                    {
                        "type": "css",
                        "value": "button[jscontroller=\"O626Fe\"][disabled]"
                    }
                ],
                "promoSelectors": [
                    "[jsname=\"v621tc\"]",
                    "div[jscontroller=\"o2G9me\"]",
                    "header[role=\"banner\"] aside"
                ],
                "buttonCopy": {
                    "install": "Add to DuckDuckGo",
                    "remove": "Remove from DuckDuckGo",
                    "unavailable": "Unsupported extension",
                    "unavailableDescription": "This extension isn't supported."
                },
                "domains": [
                    {
                        "domain": "localhost",
                        "patchSettings": [
                            {
                                "op": "replace",
                                "path": "/patchWebstore/state",
                                "value": "enabled"
                            }
                        ]
                    }
                ]
            }
        },
        "extensionManagement": {
            "state": "internal",
            "exceptions": [],
            "settings": {
                "hiddenExtensionIds": [],
                "disabledExtensionIds": [],
                "specialBehavior": {}
            },
            "features": {
                "curatedExtensions": {
                    "state": "internal",
                    "settings": {
                        "catalog": []
                    }
                }
            }
        }
    },
    "unprotectedTemporary": []
}
