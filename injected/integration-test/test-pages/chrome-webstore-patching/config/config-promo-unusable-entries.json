{
    "readme": "Test fixture for the chromeWebstorePatching feature. Mirrors the windows-override structure with the domain patch retargeted to localhost.",
    "version": 1,
    "features": {
        "chromeWebstorePatching": {
            "state": "internal",
            "exceptions": [],
            "settings": {
                "patchWebstore": {
                    "state": "disabled"
                },
                "installButtonSelectors": [
                    {
                        "type": "css",
                        "value": "button[jsname=\"wQO0od\"]"
                    },
                    {
                        "type": "css",
                        "value": "button[jsname=\"ajZLRd\"]"
                    },
                    {
                        "type": "css",
                        "value": "button[jscontroller=\"O626Fe\"][disabled]"
                    }
                ],
                "promoSelectors": [
                    {
                        "type": "css",
                        "value": "[jsname=\"v621tc\"]"
                    },
                    {
                        "type": "xpath",
                        "value": "//aside"
                    },
                    {
                        "type": "css",
                        "value": "div[jscontroller=\"o2G9me\"]"
                    },
                    {
                        "type": "css",
                        "value": "header[role=\"banner\" aside"
                    },
                    {
                        "type": "css",
                        "value": "header[role=\"banner\"] aside"
                    }
                ],
                "domains": [
                    {
                        "domain": "localhost",
                        "patchSettings": [
                            {
                                "op": "replace",
                                "path": "/patchWebstore/state",
                                "value": "enabled"
                            }
                        ]
                    }
                ]
            }
        }
    },
    "unprotectedTemporary": []
}
