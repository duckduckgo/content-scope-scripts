{
    "state": {
        "action": {
            "actionType": "extract",
            "selector": ".person-container",
            "profile": {
                "name": { "selector": ".text-xl" },
                "addressFullList": {
                    "selector": "a[href^='/address/']",
                    "findElements": true,
                    "attribute": "href",
                    "afterText": "address/"
                }
            }
        },
        "data": {
            "userProfile": {
                "firstName": "John",
                "lastName": "Sample",
                "addresses": [{ "city": "Acworth", "state": "GA" }]
            }
        }
    }
}
