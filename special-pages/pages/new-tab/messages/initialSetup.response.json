{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["widgets", "widgetConfigs", "locale", "env", "platform", "updateNotification"],
  "properties": {
    "widgets": {
      "$ref": "types/widget-list.json"
    },
    "settings": {
      "$ref": "types/settings.json"
    },
    "widgetConfigs": {
      "$ref": "types/widget-configs.json"
    },
    "locale": {
      "type": "string"
    },
    "env": {
      "type": "string",
      "enum": ["development", "production"]
    },
    "platform": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "enum": ["macos", "windows", "android", "ios", "integration"]
        }
      }
    },
    "customizer": {
      "$ref": "./types/customizer-data.json"
    },
    "updateNotification": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "types/update-notification.json"
        }
      ]
    },
    "tabs": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "types/tabs.json"
        }
      ]
    },
    "omnibar": {
      "title": "Omnibar Initial Setup",
      "description": "The subset of omnibar config that affects its height, sent up front so the loading placeholder reserves the right space. Same meaning as the matching `omnibar_getConfig` fields.",
      "type": "object",
      "required": ["mode", "enableAi", "showAiSetting"],
      "properties": {
        "mode": {
          "$ref": "./types/omnibar-config.json#/properties/mode"
        },
        "enableAi": {
          "type": "boolean"
        },
        "showAiSetting": {
          "type": "boolean"
        }
      }
    }
  }
}
