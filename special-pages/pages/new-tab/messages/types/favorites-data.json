{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Favorites Data",
  "type": "object",
  "required": ["favorites"],
  "properties": {
    "favorites": {
      "type": "array",
      "items": {
        "type": "object",
        "title": "Favorite",
        "required": ["url", "etldPlusOne", "id", "title", "favicon"],
        "properties": {
          "url": {
            "description": "The full url that will be navigated to (including path, query params and hash)",
            "examples": [
              "https://www.example.com/page?query=testing#section",
              "https://another-example.org/about"
            ],
            "type": "string"
          },
          "etldPlusOne": {
            "description": "The eTLD+1 of the URL, representing the effective top-level domain and one second-level domain",
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "examples": [
                  "example.com",
                  "apple.com",
                  "example.github.io",
                  "bbc.co.uk",
                  "my-app.herokuapp.com"
                ]
              }
            ]
          },
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "favicon": {
            "$ref": "./favicon.json"
          },
          "trackers": {
            "type": "object",
            "title": "Favorite Trackers",
            "description": "Trackers blocked on this favorite's site in the past 7 days. Omitted when none were blocked.",
            "required": ["companies", "blocked"],
            "properties": {
              "companies": {
                "description": "Display names of the tracking companies blocked on the site, most blocked first. Matches TrackerCompany.displayName",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "blocked": {
                "description": "Total tracking attempts blocked on the site",
                "type": "number"
              }
            }
          }
        }
      }
    }
  }
}
